# Скопируйте в .env и впишите свой ключ. Файл .env в git не попадает.
# Ключ OpenRouter: https://openrouter.ai/keys (без ключа копилот работает в офлайн-режиме по шаблонам)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_FALLBACK_MODELS=qwen/qwen3.8-27b:free,nvidia/nemotron-3-super-120b-a12b:free

# Docker Compose: домен для HTTPS (по умолчанию localhost)
# ALLUR_DOMAIN=allur.example.kz

# Публичное демо: PIN администратора на все изменения (пусто — без PIN) и лимит вопросов к ИИ за 10 минут с одного адреса
ALLUR_ADMIN_PIN=
ALLUR_COPILOT_LIMIT=30
